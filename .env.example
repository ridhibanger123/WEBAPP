PORT=3000
NODE_ENV=development

# MongoDB Connection String (Replace with your MongoDB Atlas URI)
# Example: mongodb+srv://admin:myPassword123@cluster0.abcde.mongodb.net/student_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your-cluster-url.mongodb.net/student_management?retryWrites=true&w=majority

# Session Security Secret (Any random long string)
SESSION_SECRET=student_management_secret_key_college_eval_2026
